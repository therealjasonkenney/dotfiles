# This is the brewfile for my home development machines.
# MacOS build version: {{ output "sw_vers" "--buildVersion" }}

cask_args(require_sha: true)

brew "chezmoi"              # Manages these dotfiles.
{{- if has "personal" .profiles }}
cask "discord"              # Tabletop RPGs.
{{- end }}
cask "firefox"              # Roll 20 / site testing
brew "gpg2"                 # Auth to git via yubikey
brew "imagemagick"          # Image transformation/conversion tools.
cask "keka"                 # Unarchive utility.
{{- if has "personal" .profiles }}
cask "omnigraffle"          # Chart/Graphing/Diagramming.
{{- end }}
cask "phoenix-slides"       # Image Folder browser.
brew "pinentry-mac"         # Auth to git via yubikey
{{- if has "personal" .profiles }}
cask "scrivener"            # Novel writing software.
{{- end }}
cask "vlc"                  # Video Player.
brew "ykman"                # Auth to git via yubikey
{{- if or (has "zoom" .enabled) (has "personal" .profiles) }}
cask "zoom"                 # Online classroom
{{- end }}

# ###########################################################################
# Dev Toolbox
# ###########################################################################

# Nerd Font for displaying Icons
cask "font-hack-nerd-font"  # Font used for Terminal and NeoVim

# Text Editing
brew "fish-lsp"             # LSP for fish (not able to be installed via mason)
cask "neovide"              # NeoVim GUI frontend.
brew "neovim"               # Modal text editor.
brew "tree-sitter-cli"      # Treesitter CLI tool used to install lang. parsers for neovim.

# Shell Environment
brew "bat"                  # CLI source code viewer
brew "direnv"               # Set environment variables when in a directory
                            # with an .envrc or .env file.
brew "fd"                   # find replacement.
brew "fish"                 # Friendly Interactive Shell
brew "git"                  # Version Control
brew "gomplate"             # Dependency free template engine.
brew "ripgrep"              # CLI Text Search
brew "sk"                   # Fuzzy finder (used in neovim's fzf plugin)
brew "starship"             # Starship Prompt.
brew "yq"                   # YAML file editor.
brew "zellij"               # Terminal Muxer

# Services
{{- if has "docker" .enabled }}
cask "docker"               # Docker Desktop
{{- end }}
{{- if has "k8s" .enabled }}
brew "kubectl"
brew "derailed/k9s/k9s"
{{- end }}
{{- if has "postgres" .enabled }}
cask "postgres-unofficial"  # Postgres Database Server
{{- end }}

# Programming Languages
{{- if or (has "asdf" .enabled) (has "elixir" .enabled) (has "javascript" .enabled) (has "ruby" .enabled) }}
brew "coreutils"            # Needed for ASDF which manages elixir, node and ruby.
brew "curl"                 # Needed for ASDF which manages elixir, node and ruby.
{{- end }}
{{- if has "elixir" .enabled }}
brew "erlang@27"            # Needed for elixir plugin.
{{- end }}
{{- if has "ruby" .enabled }}
brew "gmp"                  # Needed for ruby plugin.
brew "libyaml"              # Needed for ruby plugin.
{{- end }}
{{- if has "sass" .enabled }}
tap "sass/sass"
brew "sass"
{{- end }}

# ###########################################################################

{{- if has "hikari" .profiles }}
# ###########################################################################
# Tools for Hikari
# ###########################################################################

cask "basictex"                               # Typesetting
brew "cdrdao"                                 # Cd Archival
brew "cmake"                                  # Needed for C development
cask "affinity-designer"                      # Vector Graphics Editor
cask "affinity-photo"                         # Image Editor
cask "affinity-publisher"                     # Setting Images for Print
cask "blender"                                # 3d modeling
cask "endnote",  args: { require_sha: false}  # Manage References
cask "font-charis-sil"                        # Boardgame development
cask "godot"                                  # C++ Game Engine
cask "raspberry-pi-imager"                    # Manage homelab pi servers
cask "renpy"                                  # Python Game Engine

# ###########################################################################
{{- end }}

# ###########################################################################
# Machine Specific Tools
# ###########################################################################
{{ range .packages -}}
brew {{. | quote }}
{{ end -}}
{{ range .casks -}}
cask {{. | quote }}
{{ end -}}
